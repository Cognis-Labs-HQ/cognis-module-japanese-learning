    {
        "id": "ja:word:stationery-eraser",
        "label": "けしゴム",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["けしごむ"],
            "usage_notes": {
                "en": "A small object used to remove pencil marks. The picture shows a rubber block with eraser crumbs. Japanese 消しゴム is read けしごむ; the visible beginner card uses けしゴム.",
                "de": "Ein kleiner Gegenstand zum Entfernen von Bleistiftstrichen. Das Bild zeigt einen Radiergummi mit Abrieb. 消しゴム wird けしごむ gelesen; die sichtbare Anfängerkarte schreibt けしゴム.",
                "id": "Benda kecil untuk menghapus goresan pensil. Gambar menunjukkan penghapus karet dengan remah penghapus. 消しゴム dibaca けしごむ; kartu pemula ditulis けしゴム.",
                "ja": "鉛筆の線を消すための道具。画像は消しかすのあるゴム製の消しゴムです。消しゴムの読みは「けしごむ」で、初級カードの表記は「けしゴム」です。"
            },
            "reference_images": [
                "images/95d4e5d19a3d03a133ee2a0e31a377606ef8adaaec02696502c52863835ebb19.jpg"
            ],
            "audio": "audio/5071ba85e9d82d21f4cc5529c1ebf4cb6f6f5c70ee83baba8f650f8772d3aefb.wav"
        },
