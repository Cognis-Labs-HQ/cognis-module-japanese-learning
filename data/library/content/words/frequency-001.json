    {
        "id": "ja:word:frequency-often",
        "label": "よく",
        "class": "lexical:adverb",
        "fields": {
            "pronunciation": ["よく"],
            "usage_notes": {
                "en": "On many occasions; no fixed percentage. よく here means frequently, not skillfully. Repeated scenes suggest recurrence, but cannot distinguish often from always alone.",
                "de": "Bei vielen Gelegenheiten, ohne festen Prozentsatz. よく bedeutet hier häufig, nicht geschickt. Wiederholte Szenen deuten Wiederkehr an, unterscheiden allein aber nicht oft von immer.",
                "id": "Pada banyak kesempatan, tanpa persentase tetap. よく di sini berarti sering, bukan terampil. Adegan berulang menunjukkan pengulangan tetapi tidak dapat membedakan sering dari selalu tanpa konteks.",
                "ja": "多くの機会に起こること。固定の割合はない。ここでのよくは頻度で、上手にという意味ではない。反復場面だけでは、よくといつもを区別できない。"
            },
            "reference_images": [
                "images/e47d089183597b3d24ca079190fcba2a86e37ecb6b86cfa785154cd6f382a981.jpg"
            ],
            "audio": "audio/2e03418556598bbe0d91037d4f5ca4a3b2429ea768cef9fc660eb57f057b1a51.wav"
        },
        "tags": ["adverb"],
