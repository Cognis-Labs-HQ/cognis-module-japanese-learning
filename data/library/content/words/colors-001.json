    {
        "id": "ja:word:colors-red",
        "label": "あか",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["あか"],
            "usage_notes": {
                "en": "あか is a color noun. Example: あかが好きです。 — I like red. Do not add い mechanically to every color noun; green before a noun is みどりの.",
                "de": "あか ist ein Farbnomen. Beispiel: あかが好きです。 — Ich mag Rot. Nicht an jedes Farbnomen lässt sich い anhängen; Grün vor einem Substantiv lautet みどりの.",
                "id": "あか adalah kata benda warna. Contoh: あかが好きです。 — Saya suka warna merah. Jangan menambahkan い secara otomatis pada semua nama warna; hijau sebelum kata benda memakai みどりの.",
                "ja": "「あか」は色を表す名詞です。例：「あかが好きです。」すべての色の名詞に「い」を付けるわけではありません。「みどり」は「みどりのかばん」のように使います。"
            },
            "reference_images": [
                "images/eec12564e76455f70498ca4464fa8a4943f2f985b0d1c331819f92f23ee6db86.jpg"
            ],
            "audio": "audio/e4a3361230aec4d5182a82bcd1c6eaf2a052983c0b57c3047499c18b377ef965.wav"
        },
        "tags": ["noun", "color"],
