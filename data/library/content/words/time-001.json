    {
        "id": "ja:word:time-later",
        "label": "あとで",
        "class": "lexical:adverb",
        "fields": {
            "pronunciation": ["あとで"],
            "usage_notes": {
                "en": "あとで水を飲む。 — I will drink water later. あとで can mean later or afterwards, depending on context.",
                "de": "あとで水を飲む。 — Ich trinke später Wasser. あとで bedeutet je nach Kontext später oder danach.",
                "id": "あとで水を飲む。 — Saya akan minum air nanti. あとで dapat berarti nanti atau setelah itu, sesuai konteks.",
                "ja": "「あとで水を飲む。」のように、今より後の時や、あることの後を表します。"
            },
