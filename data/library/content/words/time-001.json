    {
        "id": "ja:word:time-yesterday",
        "label": "きのう",
        "class": "lexical:adverb",
        "fields": {
            "pronunciation": ["きのう"],
            "usage_notes": {
                "en": "きのう学校に行った。 — I went to school yesterday. The final う marks the long vowel in きのう.",
                "de": "きのう学校に行った。 — Ich bin gestern zur Schule gegangen. Das abschließende う markiert den langen Vokal in きのう.",
                "id": "きのう学校に行った。 — Saya pergi ke sekolah kemarin. う terakhir menandai vokal panjang pada きのう.",
                "ja": "「きのう学校に行った。」のように過去のことに使います。「きのう」の最後の「う」は長音を表します。"
            },
