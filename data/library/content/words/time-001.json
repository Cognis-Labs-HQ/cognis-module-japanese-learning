    {
        "id": "ja:word:time-tomorrow",
        "label": "あした",
        "class": "lexical:adverb",
        "fields": {
            "pronunciation": ["あした"],
            "usage_notes": {
                "en": "あした学校に行く。 — I will go to school tomorrow. あした is an everyday reading of 明日.",
                "de": "あした学校に行く。 — Ich gehe morgen zur Schule. あした ist eine alltagssprachliche Lesung von 明日.",
                "id": "あした学校に行く。 — Saya akan pergi ke sekolah besok. あした adalah bacaan sehari-hari untuk 明日.",
                "ja": "「あした学校に行く。」のように使います。「明日」の日常的な読みです。"
            },
            "reference_images": [
                "images/fc56a1dbd94858fa4c20e00712fcbea401bf9624eb150b000619a50ea32ee629.jpg"
            ],
            "audio": "audio/3f413ca4ccc8ae35402796b8fdce113e6bdca74527c328668076a5b930582853.wav"
        },
        "tags": ["adverb"],
        "references": [
