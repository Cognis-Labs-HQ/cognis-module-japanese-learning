    {
        "id": "ja:word:places-restaurant",
        "label": "レストラン",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["レストラン"],
            "usage_notes": {
                "en": "A place where customers buy and eat prepared meals. Plural restaurants ends in /s/. レストラン often suggests a Western-style dining establishment; it is not a literal rendering of every kind of Japanese eatery.",
                "de": "Ein Lokal, in dem Gäste zubereitete Mahlzeiten kaufen und essen. Plural restaurants mit /s/. レストラン bezeichnet häufig ein Restaurant westlichen Stils und nicht jede Art japanischen Speiselokals.",
                "id": "Tempat pelanggan membeli dan menyantap makanan siap saji. Bentuk jamak restaurants berakhir /s/. レストラン sering merujuk pada restoran bergaya Barat, bukan semua jenis tempat makan Jepang.",
                "ja": "客がお金を払って調理された食事をする店。英語の複数形 restaurants は /s/ で終わる。レストランは特に洋風の食事を出す店に使われ、あらゆる飲食店の呼び名とは限らない。"
            },
            "reference_images": [
                "images/d1548873f5db0e13114ce655f97fa53aa147d96b132f252051aff971186a5def.jpg"
            ],
            "audio": "audio/df5bfce667c3edb0f0939b31e06a642a84733d7a542eb474176328264a3ed42e.wav"
        },
