    {
        "id": "ja:word:greetings-evening",
        "label": "こんばんは",
        "class": "lexical:interjection",
        "fields": {
            "pronunciation": ["こんばんわ"],
            "usage_notes": {
                "en": "Greeting when meeting in the evening, not a bedtime farewell. Japanese writes the final syllable は but pronounces it wa. Example: Good evening! / こんばんは。",
                "de": "Gruß beim Treffen am Abend, kein Abschiedsgruß vor dem Schlafengehen. Japanisch schreibt am Ende は, spricht aber wa. Beispiel: Guten Abend!",
                "id": "Salam saat bertemu pada malam hari, bukan ucapan sebelum tidur. Suku kata akhir Jepang ditulis は tetapi dibaca wa. Contoh: Selamat malam!",
                "ja": "夕方以降に会ったときの挨拶で、就寝前の別れの言葉ではありません。末尾は「は」と書き「わ」と発音します。例：こんばんは。"
            },
            "reference_images": [
                "images/e5a6b46cabe1fa0dfd83d92c2102021cbb73cb1022537c52b277bba2cb17ceab.jpg"
            ],
            "audio": "audio/16ec181206336122e284a1860ddafef3ca02b2c1ee67edd8a44bd2c4e04bc9ac.wav"
        },
        "tags": ["greetings"],
