    {
        "id": "ja:word:directions-north",
        "label": "きた",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["きた"],
            "usage_notes": {
                "en": "North is the direction opposite south. This diagram uses the north-up map convention; north is not always the top of every map. 北 is read きた.",
                "de": "North bedeutet Norden, die Gegenrichtung zu Süden. Die Darstellung verwendet eine nach Norden ausgerichtete Karte; nicht jede Karte zeigt Norden oben. 北 wird きた gelesen.",
                "id": "North berarti utara, arah yang berlawanan dengan selatan. Diagram ini memakai konvensi utara di atas; tidak semua peta menempatkan utara di atas. 北 dibaca きた.",
                "ja": "Northは南の反対方向である北です。この図では北を上にする地図の慣例を使っていますが、すべての地図で北が上とは限りません。「北」は「きた」と読みます。"
            },
            "reference_images": [
                "images/51f803754b706194f683784a36082800596480f1829f0ec800cbe268085d4592.jpg"
            ],
            "audio": "audio/26124eeb2a43359318daa0ad92a4eebf2560ed3e2668f03fa19551ef49cdfd80.wav"
        },
        "tags": ["noun", "directions"],
