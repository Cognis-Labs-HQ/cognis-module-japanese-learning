    {
        "id": "ja:word:belongings-camera",
        "label": "カメラ",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["かめら"],
            "usage_notes": {
                "en": "A device for taking photographs or recording images. The picture shows a separate camera. English commonly has two syllables here; Japanese カメラ has three morae, か・め・ら.",
                "de": "Ein Gerät zum Fotografieren oder Aufnehmen von Bildern. Das Bild zeigt eine eigenständige Kamera. Englisch hat hier gewöhnlich zwei Silben, japanisch カメラ drei Moren: か・め・ら.",
                "id": "Alat untuk memotret atau merekam gambar. Ilustrasi menunjukkan kamera tersendiri. Bahasa Inggris lazim memakai dua suku kata; カメラ dalam bahasa Jepang memiliki tiga mora: か・め・ら.",
                "ja": "写真や映像を撮る機器。画像は単体のカメラです。英語では通常2音節、日本語のカメラは「か・め・ら」の3拍です。"
            },
            "reference_images": [
                "images/e97158fa872ea1c08436de42d1314e8058ca1997f43f561d4afb4efeb2b69fba.jpg"
            ],
