    {
        "id": "ja:word:belongings-watch",
        "label": "うでどけい",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["うでどけい"],
            "usage_notes": {
                "en": "A small timepiece worn on the wrist. This noun sense is separate from the verb watch and from a room clock. Japanese 腕時計 is うでどけい: the compound uses ど, not と.",
                "de": "Eine kleine Uhr am Handgelenk. Dieses Nomen ist vom Verb watch und einer Zimmeruhr zu unterscheiden. 腕時計 wird うでどけい gelesen: im Kompositum steht ど, nicht と.",
                "id": "Penunjuk waktu kecil yang dipakai di pergelangan tangan. Makna nomina ini berbeda dari verba watch dan jam ruangan. 腕時計 dibaca うでどけい: kata majemuk ini memakai ど, bukan と.",
                "ja": "手首につける小さな時計。英語の動詞watchや室内の時計とは区別します。腕時計の読みは「うでどけい」で、複合語では「と」でなく「ど」になります。"
            },
            "reference_images": [
                "images/8b684ed0a7615b1f2238c571639fdb1d86e3327bd9e788498b45e0b09d4647eb.jpg"
            ],
