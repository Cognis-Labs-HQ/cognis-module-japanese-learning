    {
        "id": "ja:word:core-sleep",
        "label": "ねる",
        "class": "lexical:verb",
        "fields": {
            "pronunciation": ["ねる"],
            "usage_notes": {
                "en": "寝る can mean sleep, go to bed or lie down depending on context; it is not identical to every English use of sleep. Ichidan: ねた, ねて, ねない; standard potential ねられる. The picture shows actual sleep.",
                "de": "寝る kann je nach Kontext schlafen, zu Bett gehen oder sich hinlegen heißen; nicht jede Verwendung von sleep entspricht ihm. Ichidan: ねた, ねて, ねない; standardsprachliches Potential ねられる. Das Bild zeigt tatsächlichen Schlaf.",
                "id": "寝る dapat berarti tidur, pergi tidur, atau berbaring sesuai konteks; tidak sama dengan semua penggunaan sleep. Ichidan: ねた, ねて, ねない; potensial baku ねられる. Gambar memperlihatkan tidur.",
                "ja": "寝るは文脈により睡眠、就寝、横になることを表し、英語sleepの全用法と一致するわけではない。一段活用で、ねた・ねて・ねない、標準的な可能形はねられる。画像は睡眠中の場面。"
            },
            "reference_images": [
                "images/f9b26425de36c8a8417a62ffc85efa30e347d00bf7a2934b031037d7e7dbab6e.jpg"
            ],
            "audio": "audio/d18b23f2efd5e37302beaed08404e82d554e9acef0df42b3081fd4665b8624af.wav"
        },
