    {
        "id": "ja:word:core-read",
        "label": "よむ",
        "class": "lexical:verb",
        "fields": {
            "pronunciation": ["よむ"],
            "usage_notes": {
                "en": "Read written material. を marks the material read. Godan m: よんだ, よんで, よまない; potential よめる.",
                "de": "Geschriebenes lesen. を markiert das Gelesene. Godan auf m: よんだ, よんで, よまない; Potential よめる.",
                "id": "Membaca bahan tertulis. を menandai bahan yang dibaca. Godan m: よんだ, よんで, よまない; potensial よめる.",
                "ja": "書かれたものを読む。対象ををで示す。マ行五段で、よんだ・よんで・よまない、可能形はよめる。"
            },
            "reference_images": [
                "images/dff4544ddbe659e92785fba3f86ac83c5bd77dd5e9976b211b07db3d11373d65.jpg"
