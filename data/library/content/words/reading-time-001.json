    {
        "id": "ja:word:reading-time-night",
        "label": "よる",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["よる"],
            "usage_notes": {
                "en": "The dark part of the day. Japanese 夜 is read よる here, not the reading や used in some compounds. Example: 夜に寝る = sleep at night.",
                "de": "Die dunkle Tageszeit. 夜 wird hier よる gelesen, nicht や wie in manchen Zusammensetzungen. Beispiel: 夜に寝る = nachts schlafen.",
                "id": "Bagian hari saat gelap. 夜 dibaca よる di sini, bukan や yang dipakai dalam beberapa kata majemuk. Contoh: 夜に寝る = tidur pada malam hari.",
                "ja": "暗い時間帯。ここでの夜の読みは「よる」で、熟語などの「や」とは区別します。例：夜に寝る。"
            },
            "reference_images": [
                "images/46a2ea9d9ec09aa5d55879aa907cf0671cd4b4f88fcb5a5d728e8000eb501986.jpg"
            ],
