    {
        "id": "ja:word:reading-time-newspaper",
        "label": "しんぶん",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["しんぶん"],
            "usage_notes": {
                "en": "A publication reporting news; the picture shows a printed newspaper, not a book or personal letter. Japanese 新聞 is read しんぶん. Example: read a newspaper / 新聞を読む.",
                "de": "Eine Veröffentlichung mit Nachrichten; das Bild zeigt eine gedruckte Zeitung, kein Buch oder einen persönlichen Brief. 新聞 wird しんぶん gelesen. Beispiel: eine Zeitung lesen.",
                "id": "Terbitan yang memuat berita; gambar menunjukkan surat kabar cetak, bukan buku atau surat pribadi. 新聞 dibaca しんぶん. Contoh: membaca surat kabar.",
                "ja": "ニュースを伝える刊行物。画像は紙の新聞で、書籍や個人の手紙ではありません。新聞は「しんぶん」と読みます。例：新聞を読む。"
            },
            "reference_images": [
