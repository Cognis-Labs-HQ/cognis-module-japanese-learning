    {
        "id": "ja:word:reading-time-morning",
        "label": "あさ",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["あさ"],
            "usage_notes": {
                "en": "The early part of the day. Japanese 朝 is read あさ; this noun is not the greeting おはようございます. Example: 朝に読む = read in the morning.",
                "de": "Der frühe Teil des Tages. 朝 wird あさ gelesen; dieses Nomen ist nicht der Gruß おはようございます. Beispiel: 朝に読む = morgens lesen.",
                "id": "Bagian awal hari. 朝 dibaca あさ; nomina ini bukan salam おはようございます. Contoh: 朝に読む = membaca pada pagi hari.",
                "ja": "一日の早い時間帯。朝は「あさ」と読み、挨拶のおはようございますとは別の名詞です。例：朝に読む。"
            },
            "reference_images": [
                "images/a818cc81eef0979660691eb76bc8800bd2140ea695b0f1d86e04c51daf45ef0a.jpg"
            ],
            "audio": "audio/3900a1d913de835207aa4c0b601b96b3724df8f26724efad6be9e31864dbeb3a.wav"
        },
        "tags": ["reading-time"],
