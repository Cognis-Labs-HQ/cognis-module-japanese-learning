    {
        "id": "ja:word:reading-time-book",
        "label": "ほん",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["ほん"],
            "usage_notes": {
                "en": "A book for reading. Japanese 本 is read ほん in this noun; the counter for long objects is a different use. Example: 本を読む = read a book.",
                "de": "Ein Buch zum Lesen. 本 wird als dieses Nomen ほん gelesen; das Zählwort für längliche Gegenstände ist eine andere Verwendung. Beispiel: 本を読む = ein Buch lesen.",
                "id": "Buku untuk dibaca. 本 sebagai nomina ini dibaca ほん; penggunaannya sebagai kata bantu bilangan benda panjang berbeda. Contoh: 本を読む = membaca buku.",
                "ja": "読むための書物。本はここでは「ほん」と読み、細長い物を数える助数詞とは用法を区別します。例：本を読む。"
            },
            "reference_images": [
                "images/4f0116cb5e2975150abfdcb51f544bec6af79ee87247f68da55fc1354a58d0f5.jpg"
            ],
