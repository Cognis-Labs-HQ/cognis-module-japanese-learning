    {
        "id": "ja:word:nature-forest",
        "label": "もり",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["もり"],
            "usage_notes": {
                "en": "An area covered with many trees, not one tree. 森 is もり with two short morae. Forests ends in /sts/.",
                "de": "Ein Gebiet mit vielen Bäumen, kein einzelner Baum. 森 lautet もり mit zwei kurzen Moren. Forests endet auf /sts/.",
                "id": "Area dengan banyak pohon, bukan satu pohon. 森 dibaca もり dengan dua mora pendek. Forests berakhir /sts/.",
                "ja": "多数の木が生える地域で、一本の木ではない。森は短い二拍のもり。Forests の語尾は /sts/。"
            },
            "reference_images": [
