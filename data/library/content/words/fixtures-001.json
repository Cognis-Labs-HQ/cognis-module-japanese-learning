    {
        "id": "ja:word:fixtures-oven",
        "label": "オーブン",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["オーブン"],
            "usage_notes": {
                "en": "An enclosed appliance for baking or roasting, not a microwave or stovetop. オーブン begins with long オー and uses voiced ブ.",
                "de": "Geschlossenes Gerät zum Backen oder Braten, keine Mikrowelle oder Herdplatte. オーブン beginnt mit langem オー und enthält stimmhaftes ブ.",
                "id": "Alat tertutup untuk memanggang, bukan microwave atau kompor. オーブン diawali オー panjang dan memakai ブ bersuara.",
                "ja": "焼くための庫内を持つ器具。電子レンジやコンロではない。オーブンは長音オーで始まり、ブは濁音。"
            },
