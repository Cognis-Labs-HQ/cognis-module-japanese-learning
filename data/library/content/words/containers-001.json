    {
        "id": "ja:word:containers-basket",
        "label": "かご",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["かご"],
            "usage_notes": {
                "en": "A container for carrying or storing things. The picture shows an open woven basket with a handle. Here Japanese かご means basket, not an animal cage.",
                "de": "Ein Behälter zum Tragen oder Aufbewahren. Das Bild zeigt einen offenen geflochtenen Korb mit Henkel. かご bedeutet hier Korb, nicht Tierkäfig.",
                "id": "Wadah untuk membawa atau menyimpan barang. Gambar menunjukkan keranjang anyaman terbuka dengan pegangan. かご di sini berarti keranjang, bukan kandang hewan.",
                "ja": "物を運んだり入れたりする容器。画像は持ち手のある編みかごです。ここでのかごは収納・運搬用で、動物を入れるおりの意味ではありません。"
            },
            "reference_images": [
                "images/0784d38faebf9dd77945b070296951ed84d262987c09012eee6d0f9714dfa1b4.jpg"
            ],
            "audio": "audio/99b726075e1decca6ff9a81b652aa0a76802ff830615798ad7a04aa4065e089c.wav"
        },
