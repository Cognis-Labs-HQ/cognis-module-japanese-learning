    {
        "id": "ja:word:containers-box",
        "label": "はこ",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["はこ"],
            "usage_notes": {
                "en": "A container with a base and sides. The picture shows an open cardboard box. This is the noun, not the English verb meaning fight with fists. Japanese 箱 is はこ.",
                "de": "Ein Behälter mit Boden und Seitenwänden. Das Bild zeigt einen offenen Karton. Gemeint ist das Nomen, nicht das englische Verb für den Faustkampf. 箱 wird はこ gelesen.",
                "id": "Wadah dengan dasar dan sisi. Gambar menunjukkan kotak kardus terbuka. Ini nomina, bukan verba Inggris yang berarti bertinju. 箱 dibaca はこ.",
                "ja": "底と側面のある入れ物。画像は開いた段ボール箱です。英語boxはここでは名詞で、ボクシングをするという動詞ではありません。箱の読みは「はこ」です。"
            },
            "reference_images": [
                "images/8bd3426f612701c4f00d6b66fb83d7417f2fba3b18f3eab7485a016e16ca2b37.jpg"
            ],
            "audio": "audio/a015a15942185531748807169edc0f4698413e5468af7f662bbae5ba6946aa96.wav"
        },
        "tags": ["containers"],
