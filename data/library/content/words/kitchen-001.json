    {
        "id": "ja:word:kitchen-pan",
        "label": "フライパン",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["フライパン"],
            "usage_notes": {
                "en": "A cooking pan; this picture selects a shallow frying pan. Japanese フライパン specifically means frying pan. Pans ends in /z/.",
                "de": "Eine Kochpfanne; die Abbildung zeigt eine flache Bratpfanne. フライパン bedeutet speziell Bratpfanne. Pans endet auf /z/.",
                "id": "Wajan untuk memasak; gambar menunjukkan wajan penggorengan dangkal. フライパン berarti wajan penggorengan. Pans berakhir /z/.",
                "ja": "調理用の容器で、絵は浅いフライパン。英語 pan はより広く使われる。Pans の語尾は /z/。"
            },
