    {
        "id": "ja:word:kitchen-bowl",
        "label": "ボウル",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["ボウル"],
            "usage_notes": {
                "en": "An open round container. The picture shows a mixing bowl; Japanese ボウル is common for a cooking or mixing bowl. ボウ is a long sound, not ボ alone. Bowls ends in /z/.",
                "de": "Ein offenes rundes Gefäß; abgebildet ist eine Rührschüssel. ボウル bezeichnet häufig eine Küchen- oder Rührschüssel. ボウ ist lang. Bowls endet auf /z/.",
                "id": "Wadah bundar terbuka; gambar menunjukkan mangkuk pencampur. ボウル sering berarti mangkuk untuk memasak atau mencampur. ボウ berbunyi panjang. Bowls berakhir /z/.",
                "ja": "口の開いた丸い容器。絵は調理用ボウル。ボウは長い音。英語 bowls の語尾は /z/。"
            },
            "reference_images": [
                "images/2407a2a0dbf2e7f7cdabb49e05256b9362d4a7c0247bdba9ac38c669ee83e6ed.jpg"
            ],
            "audio": "audio/a4caf27b3c13ead375f97ba9ee0fbbb2362b141ed8650902f28ed93b7db42579.wav"
        },
        "tags": ["noun", "kitchen"],
