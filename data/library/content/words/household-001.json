    {
        "id": "ja:word:household-clean",
        "label": "そうじする",
        "class": "lexical:verb",
        "fields": {
            "pronunciation": ["そうじする"],
            "usage_notes": {
                "en": "Verb: remove dirt or dust, illustrated by cleaning a room; not the adjective clean. Cleaned ends in /d/. そうじする is a suru verb with long そう; its potential form is そうじできる.",
                "de": "Verb: Schmutz oder Staub entfernen, hier beim Reinigen eines Raumes; nicht das Adjektiv sauber. Cleaned endet auf /d/. そうじする ist ein Suru-Verb mit langem そう; Möglichkeitsform そうじできる.",
                "id": "Verba: menghilangkan kotoran atau debu, dicontohkan dengan membersihkan ruangan; bukan adjektiva bersih. Cleaned berakhir /d/. そうじする adalah verba suru dengan vokal panjang pada そう; bentuk potensial そうじできる.",
                "ja": "汚れやほこりを取り除く動作で、部屋の掃除を例示する。「きれいな」という形容の意味ではない。英語の cleaned は /d/ で終わる。そうじするはサ変動詞で、そうは長音、可能形はそうじできる。"
            },
            "reference_images": [
                "images/4f86766b3d1007d34a978a2c86a2656a5011a778fb591446ed88484b3770bea6.jpg"
            ],
            "audio": "audio/7c70efb2f24b3b66cb5da738c2e2d694336ed2957ffdc0954b3a771007e31c58.wav"
        },
        "tags": ["verb", "household-form-clean"],
