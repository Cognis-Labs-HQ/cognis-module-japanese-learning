    {
        "id": "ja:word:household-cook",
        "label": "りょうりする",
        "class": "lexical:verb",
        "fields": {
            "pronunciation": ["りょうりする"],
            "usage_notes": {
                "en": "Verb: prepare food, especially with heat; not the noun for a person who cooks. Cooked ends in /t/. りょうりする is a suru verb; its potential form is りょうりできる.",
                "de": "Verb: Essen zubereiten, besonders durch Erhitzen; nicht die Berufsbezeichnung Koch. Cooked endet auf /t/. りょうりする ist ein Suru-Verb; die Möglichkeitsform lautet りょうりできる.",
                "id": "Verba: menyiapkan makanan, terutama dengan panas; bukan nomina untuk juru masak. Cooked berakhir /t/. りょうりする adalah verba suru; bentuk potensialnya りょうりできる.",
                "ja": "食べ物を調理する動作で、料理人を表す名詞ではない。英語の cooked は /t/ で終わる。りょうりするはサ変動詞で、可能形はりょうりできる。"
            },
            "reference_images": [
                "images/be2e0469e0ff2472cd625ab0a4bb46afa06fd1946f05b919777814a070e64c16.jpg"
