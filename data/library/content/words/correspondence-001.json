    {
        "id": "ja:word:correspondence-letter",
        "label": "てがみ",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["てがみ"],
            "usage_notes": {
                "en": "A written message to another person, not a letter of the alphabet. The picture shows the message sheet beside its envelope. Plural letters ends in /z/.",
                "de": "Eine schriftliche Nachricht an eine andere Person, kein Buchstabe. Das Bild zeigt das beschriebene Blatt neben dem Umschlag. Letters endet mit /z/.",
                "id": "Pesan tertulis kepada orang lain, bukan huruf alfabet. Gambar menunjukkan lembar pesan di samping amplopnya. Letters berakhir dengan /z/.",
                "ja": "人に宛てた文章です。英語letterの文字という意味は扱いません。画像は封筒の横に置かれた便箋です。複数形lettersは/z/で終わります。"
            },
            "reference_images": [
