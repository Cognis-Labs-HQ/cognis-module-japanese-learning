    {
        "id": "ja:word:school-notebook",
        "label": "ノート",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["ノート"],
            "usage_notes": {
                "en": "A paper book for writing notes, not a notebook computer. Write in a notebook. ノート here means the physical notebook and has a long ノー. Plural notebooks ends in /s/.",
                "de": "Ein Papierbuch für Notizen, kein Notebook-Computer. Auf Englisch: write in a notebook. ノート bezeichnet hier das Heft und enthält langes ノー. Notebooks endet auf /s/.",
                "id": "Buku kertas untuk mencatat, bukan komputer notebook. Dalam bahasa Inggris: write in a notebook. ノート di sini berarti buku fisik dan memakai ノー panjang. Notebooks berakhir /s/.",
                "ja": "メモを書く紙の本で、ノートパソコンではない。英語では write in a notebook と言う。ここでのノートは物としてのノートで、ノーは長音。英語の複数形 notebooks は /s/ で終わる。"
            },
