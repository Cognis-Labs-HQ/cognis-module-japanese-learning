    {
        "id": "ja:word:warm-accessories-scarf",
        "label": "マフラー",
        "class": "lexical:noun",
        "fields": {
            "pronunciation": ["マフラー"],
            "usage_notes": {
                "en": "Warm cloth worn around the neck. This card selects a winter scarf, not a decorative headscarf or an exhaust muffler. Preferred plural scarves changes /f/ to /vz/; scarfs also exists. Japanese マフラー retains its final long vowel.",
                "de": "Warmes Tuch für den Hals. Gemeint ist ein Winterschal, kein Kopftuch oder Auspuffschalldämpfer. Die bevorzugte Mehrzahl scarves ändert /f/ zu /vz/; scarfs ist ebenfalls möglich. マフラー behält den langen Endvokal.",
                "id": "Kain hangat yang dipakai di leher. Ini syal musim dingin, bukan penutup kepala atau peredam knalpot. Bentuk jamak utama scarves mengubah /f/ menjadi /vz/; scarfs juga ada. マフラー mempertahankan vokal panjang terakhir.",
                "ja": "首に巻く防寒用の布です。頭を覆うスカーフや車の消音器の意味は扱いません。英語の主な複数形scarvesは/f/が/vz/に変わり、scarfsという形もあります。マフラーの最後の長音を保ちます。"
            },
            "reference_images": [
                "images/19a83b6fe60f75bca6a3c1cc47ba0b3bcef5f4361225b4ad291e9ea1ea87aa50.jpg"
            ],
            "audio": "audio/ff183b311de2f276c8afb68d751ffe8064c382f987739fea3cb88e680ebe328c.wav"
        },
        "tags": ["noun", "warm-accessories"],
