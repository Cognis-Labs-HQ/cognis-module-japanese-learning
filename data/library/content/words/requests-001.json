    {
        "id": "ja:word:requests-please",
        "label": "おねがいします",
        "class": "lexical:interjection",
        "fields": {
            "pronunciation": ["おねがいします"],
            "usage_notes": {
                "en": "English Please is the courtesy expression here, distinct from the existing verb to please. Japanese おねがいします is a conventional polite request, not a word inserted wherever English please appears. ゆっくりお願いします means Slowly, please when requesting slower speech.",
                "de": "Englisch Please ist hier die Höflichkeitsformel, nicht das bestehende Verb erfreuen. おねがいします ist eine feste höfliche Bitte und wird nicht überall eingesetzt, wo Englisch please steht. ゆっくりお願いします bedeutet bei einer Sprechbitte Langsamer, bitte.",
                "id": "Please di sini adalah ungkapan kesopanan, berbeda dari verba menyenangkan yang sudah ada. おねがいします adalah permintaan sopan yang lazim, bukan kata yang disisipkan di semua tempat please dipakai. ゆっくりお願いします meminta bicara pelan.",
                "ja": "英語Pleaseは依頼の丁寧表現で、既存の喜ばせるという動詞とは別。おねがいしますは定型的な依頼で、英語pleaseの全位置に挿入する単語ではない。発話速度の依頼でゆっくりお願いしますはゆっくり話してほしい意味。"
            },
            "reference_images": [
                "images/75aa476925c936b184f5804ba3d6b02d9bdc7752d0e1aa4d6db566c7b76eaf50.jpg"
            ],
            "audio": "audio/985501ea09261b61f93349b9f96b5c90bb3242735787ee35f17a95d4b64abc79.wav"
        },
