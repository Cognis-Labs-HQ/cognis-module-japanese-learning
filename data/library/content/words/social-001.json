    {
        "id": "ja:word:social-greeting",
        "label": "こんにちは",
        "class": "lexical:interjection",
        "fields": {
            "pronunciation": ["こんにちわ"],
            "usage_notes": {
                "en": "A daytime greeting; the final は is pronounced wa. Written こんにちは, reading こんにちわ. The greeting scene cannot establish exact wording or social register by itself.",
                "de": "Ein Tagesgruß; das abschließende は wird wa gesprochen. Geschrieben こんにちは, Aussprache こんにちわ. Das Begrüßungsbild legt Wortlaut und Register nicht allein fest.",
                "id": "Sapaan siang hari; は terakhir diucapkan wa. Ditulis こんにちは, dibaca こんにちわ. Gambar sapaan tidak menentukan kata atau ragam sosial secara pasti.",
                "ja": "昼間のあいさつ。末尾のははワと発音する。表記はこんにちは、読みはこんにちわ。画像だけで正確な発話や待遇の程度は決まらない。"
            },
            "reference_images": [
                "images/8b03eee8eaf8eeffa10505705523edd9e687f48f02d339b2425d3296f1d61456.jpg"
            ],
            "audio": "audio/201867d619fb4ce848f1b933992d1ec9219d540f51f511833c6cdcf580c448bd.wav"
        },
