    {
        "id": "ja:word:social-farewell",
        "label": "さようなら",
        "class": "lexical:interjection",
        "fields": {
            "pronunciation": ["さようなら"],
            "usage_notes": {
                "en": "A farewell, including established school leave-taking. It can sound more final or formal than casual see you; not a universal substitute for じゃあね or またね. Preserve the long よう sound.",
                "de": "Ein Abschiedsgruß, etwa beim üblichen Schulabschied. Kann endgültiger oder förmlicher als ein lockeres Bis dann wirken; kein allgemeiner Ersatz für じゃあね oder またね. Den langen よう-Laut bewahren.",
                "id": "Salam perpisahan, termasuk saat berpisah di sekolah. Dapat terdengar lebih final atau formal daripada sampai nanti; bukan pengganti universal じゃあね atau またね. Pertahankan bunyi panjang よう.",
                "ja": "学校などの定型的な別れのあいさつにも使う。気軽なまたねより改まった、または区切りのある響きになる場合があり、じゃあねやまたねの万能な代用ではない。ようの長音を保つ。"
            },
            "reference_images": [
                "images/f6871cdc1f71084c49eb3587db404f7b01b1a220ee418dee0854f49255f2049c.jpg"
            ],
            "audio": "audio/57de8aef1fdd2c13421228ce70b2ff644aab7d97005d06aa0cbb9bf9c2311ef1.wav"
        },
