[
    {
        "id": "ja:def:sentence-particle-example-kedo",
        "label": "It is school, but I go.",
        "fields": {
            "string_key": "japanese:definitions:sentence-particle-example-kedo",
            "translations": {
                "de": "Es ist Schule, aber ich gehe.",
                "en": "It is school, but I go.",
                "id": "Ini sekolah, tapi aku pergi.",
                "ja": "学校ですが、行きます。"
            }
        }
    },
    {
        "id": "ja:def:sentence-particle-example-keredo",
        "label": "It is school, although I go.",
        "fields": {
            "string_key": "japanese:definitions:sentence-particle-example-keredo",
            "translations": {
                "de": "Es ist Schule, obwohl ich gehe.",
