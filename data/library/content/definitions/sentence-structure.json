    {
        "id": "ja:def:sentence-soredemo-inu-wa-aruku",
        "label": "Nevertheless, the dog walks.",
        "fields": {
            "string_key": "japanese:definitions:sentence-soredemo-inu-wa-aruku",
            "translations": {
                "de": "Trotzdem läuft der Hund.",
                "en": "Nevertheless, the dog walks.",
                "id": "Meskipun demikian, anjing itu berjalan.",
                "ja": "それでも犬は歩く。"
            }
        },
        "class": "definition",
        "hidden": true
    },
    {
        "id": "ja:def:sentence-inu-wa-ookii-desuga-neko-wa-chiisai",
        "label": "The dog is big, but the cat is small.",
        "fields": {
            "string_key": "japanese:definitions:sentence-inu-wa-ookii-desuga-neko-wa-chiisai",
            "translations": {
                "de": "Der Hund ist groß, aber die Katze ist klein.",
                "en": "The dog is big, but the cat is small.",
                "id": "Anjing itu besar, tetapi kucing itu kecil.",
                "ja": "犬は大きいですが、猫は小さい。"
            }
        },
        "class": "definition",
        "hidden": true
    },
    {
        "id": "ja:def:sentence-dakedo-neko-wa-koko-ni-iru",
        "label": "But the cat is here.",
        "fields": {
            "string_key": "japanese:definitions:sentence-dakedo-neko-wa-koko-ni-iru",
            "translations": {
                "de": "Aber die Katze ist hier.",
                "en": "But the cat is here.",
                "id": "Tetapi kucing itu ada di sini.",
                "ja": "だけど猫はここにいる。"
            }
        },
        "class": "definition",
        "hidden": true
    },
    {
        "id": "ja:def:sentence-shikashi-neko-wa-chiisai",
        "label": "However, the cat is small.",
        "fields": {
            "string_key": "japanese:definitions:sentence-shikashi-neko-wa-chiisai",
            "translations": {
                "de": "Die Katze ist jedoch klein.",
                "en": "However, the cat is small.",
                "id": "Namun, kucing itu kecil.",
                "ja": "しかし猫は小さい。"
            }
        },
        "class": "definition",
        "hidden": true
    },
    {
        "id": "ja:def:sentence-soshite-inu-mo-kuru",
        "label": "And then the dog also comes.",
        "fields": {
            "string_key": "japanese:definitions:sentence-soshite-inu-mo-kuru",
            "translations": {
                "de": "Und dann kommt auch der Hund.",
                "en": "And then the dog also comes.",
                "id": "Lalu anjing itu juga datang.",
                "ja": "そして犬も来る。"
            }
        },
        "class": "definition",
        "hidden": true
    },
    {
        "id": "ja:def:sentence-sorekara-gakkou-ni-iku",
        "label": "After that, I go to school.",
        "fields": {
            "string_key": "japanese:definitions:sentence-sorekara-gakkou-ni-iku",
            "translations": {
                "de": "Danach gehe ich zur Schule.",
                "en": "After that, I go to school.",
                "id": "Setelah itu, saya pergi ke sekolah.",
                "ja": "それから学校に行く。"
            }
        },
        "class": "definition",
        "hidden": true
    },
    {
        "id": "ja:def:sentence-dakara-nihongo-wo-manabu",
        "label": "Therefore, I study Japanese.",
        "fields": {
            "string_key": "japanese:definitions:sentence-dakara-nihongo-wo-manabu",
            "translations": {
                "de": "Deshalb lerne ich Japanisch.",
                "en": "Therefore, I study Japanese.",
                "id": "Karena itu, saya belajar bahasa Jepang.",
                "ja": "だから日本語を学ぶ。"
            }
        },
        "class": "definition",
        "hidden": true
    },
    {
        "id": "ja:def:sentence-nanode-mizu-wo-nomu",
