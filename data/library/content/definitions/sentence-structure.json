            "translations": {
                "de": "Daher trinke ich Wasser.",
                "en": "Therefore, I drink water.",
                "id": "Karena itu, saya minum air.",
                "ja": "なので水を飲む。"
            }
        },
        "class": "definition",
        "hidden": true
    },
    {
        "id": "ja:def:sentence-watashi-wa-gakusei-da",
