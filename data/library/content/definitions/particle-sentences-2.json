            }
        },
        "class": "content:definition"
    },
    {
        "id": "ja:def:sentence-particle-toka",
        "label": "I like things such as cats and dogs.",
        "fields": {
            "string_key": "japanese:definitions:sentence-particle-toka",
            "translations": {
