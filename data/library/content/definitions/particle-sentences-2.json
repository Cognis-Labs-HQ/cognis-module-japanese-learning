[
    {
        "id": "ja:def:sentence-particle-kedo",
        "label": "It is small but strong.",
        "fields": {
            "string_key": "japanese:definitions:sentence-particle-kedo",
            "translations": {
                "de": "Es ist klein, aber stark.",
                "en": "It is small but strong.",
                "id": "Itu kecil tapi kuat.",
                "ja": "小さいけど強い"
            }
        },
        "class": "content:definition"
    },
    {
        "id": "ja:def:sentence-particle-keredo",
        "label": "It is difficult, but I like it.",
        "fields": {
            "string_key": "japanese:definitions:sentence-particle-keredo",
            "translations": {
                "de": "Es ist schwierig, aber ich mag es.",
                "en": "It is difficult, but I like it.",
                "id": "Itu sulit, tapi saya menyukainya.",
                "ja": "難しいけれど好き"
            }
        },
        "class": "content:definition"
    },
    {
        "id": "ja:def:sentence-particle-shi",
        "label": "It is big and strong.",
        "fields": {
            "string_key": "japanese:definitions:sentence-particle-shi",
            "translations": {
                "de": "Es ist groß und stark.",
                "en": "It is big and strong.",
                "id": "Itu besar dan kuat.",
                "ja": "大きいし強い"
            }
        },
        "class": "content:definition"
    },
    {
