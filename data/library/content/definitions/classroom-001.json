[
    {
        "id": "ja:definition:classroom-1",
        "label": "友達と学校に行く",
        "class": "definition",
        "hidden": true,
        "fields": {
            "string_key": "japanese:definitions:classroom.1",
            "translations": {
                "en": "I go to school with a friend.",
                "de": "Ich gehe mit einem Freund zur Schule.",
                "id": "Saya pergi ke sekolah bersama teman.",
                "ja": "友達と学校に行く。"
            }
        }
    },
    {
        "id": "ja:definition:classroom-2",
        "label": "先生は学校にいる",
        "class": "definition",
        "hidden": true,
        "fields": {
            "string_key": "japanese:definitions:classroom.2",
            "translations": {
                "en": "The teacher is at school.",
                "de": "Die Lehrkraft ist in der Schule.",
                "id": "Guru itu ada di sekolah.",
                "ja": "先生は学校にいる。"
            }
        }
    },
    {
        "id": "ja:definition:classroom-3",
        "label": "ノートとペンをかう",
        "class": "definition",
        "hidden": true,
        "fields": {
            "string_key": "japanese:definitions:classroom.3",
            "translations": {
                "en": "I buy a notebook and a pen.",
                "de": "Ich kaufe ein Notizbuch und einen Stift.",
                "id": "Saya membeli buku catatan dan pena.",
                "ja": "ノートとペンを買う。"
            }
        }
    },
    {
        "id": "ja:definition:classroom-4",
        "label": "学校で友達と日本語を学ぶ",
        "class": "definition",
        "hidden": true,
        "fields": {
            "string_key": "japanese:definitions:classroom.4",
            "translations": {
                "en": "I learn Japanese with a friend at school.",
                "de": "Ich lerne in der Schule mit einem Freund Japanisch.",
                "id": "Saya belajar bahasa Jepang bersama teman di sekolah.",
                "ja": "学校で友達と日本語を学ぶ。"
            }
        }
    },
    {
        "id": "ja:definition:classroom-5",
        "label": "私のえんぴつはここにある",
        "class": "definition",
        "hidden": true,
        "fields": {
            "string_key": "japanese:definitions:classroom.5",
            "translations": {
                "en": "My pencil is here.",
                "de": "Mein Bleistift ist hier.",
                "id": "Pensil saya ada di sini.",
                "ja": "私の鉛筆はここにある。"
            }
        }
    },
    {
        "id": "ja:definition:classroom-6",
        "label": "学校からえきまで歩く",
        "class": "definition",
        "hidden": true,
        "fields": {
            "string_key": "japanese:definitions:classroom.6",
            "translations": {
                "en": "I walk from the school to the station.",
                "de": "Ich gehe von der Schule zum Bahnhof.",
                "id": "Saya berjalan kaki dari sekolah ke stasiun.",
                "ja": "学校から駅まで歩く。"
            }
        }
    }
]
